# Copy to .env and fill in. Never commit real secrets.

# Required: at least 32 random characters (openssl rand -hex 32)
COOKIE_SECRET=

# Web app origin (CORS + CSRF + login redirects)
WEB_ORIGIN=http://localhost:3000
PORT=4000

# Optional: PostgreSQL. Requires `pnpm --filter @inside-tech/api add pg`
# and the migrations in db/migrations applied in order.
DATABASE_URL=

# Optional: sign-in with any OpenID Connect provider (Google, Microsoft, Keycloak…)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/auth/callback

# Optional: comma-separated emails that become admins on sign-in
ADMIN_EMAILS=

# Optional: Stripe Checkout (prices come from your Stripe dashboard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_CLASSROOM=
